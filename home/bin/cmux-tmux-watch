#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "typer",
# ]
# ///
"""Watch for tmux sessions and ensure each has a matching cmux workspace.

Polls the tmux server on an interval and creates a cmux workspace for any
session that doesn't already have one. Unlike cmux-tmux-sync, this runs
continuously and covers both attached and detached sessions — the only
requirement is that no cmux workspace already covers the session.
"""

import signal
import sys
import time
from typing import Annotated

import typer

from _cmux import Workspace, cmux_workspaces, create_workspace, tmux_sessions


def sync_once(recent: dict[str, float], *, grace: float) -> int:
    sessions = tmux_sessions()
    if not sessions:
        return 0

    covered = {ws.session_name for ws in cmux_workspaces()}
    now = time.monotonic()
    # Forget sessions whose grace window has passed, so one that genuinely
    # closes and reopens is created again rather than suppressed forever.
    for name in [n for n, t in recent.items() if now - t > grace]:
        del recent[name]
    created = 0

    for session in sorted(sessions, key=lambda s: s.name):
        # `covered` is a snapshot; `recent` covers the window where cmux hasn't
        # yet reported a workspace we just created, preventing a duplicate.
        if session.name in covered or session.name in recent:
            continue

        ws = Workspace(
            title=session.name,
            cwd=session.path,
            tmux=True,
            session=session.name,
        )
        ref = create_workspace(ws)
        recent[session.name] = time.monotonic()
        print(f"sync   {session.name} -> {ref} ({session.path})")
        created += 1

    return created


def main(
    interval: Annotated[
        float,
        typer.Option("--interval", "-i", help="Seconds between polls"),
    ] = 5.0,
    once: Annotated[
        bool,
        typer.Option("--once", help="Run a single sync and exit"),
    ] = False,
    max_failures: Annotated[
        int,
        typer.Option("--max-failures", help="Exit after this many consecutive errors"),
    ] = 5,
) -> None:
    if once:
        sync_once({}, grace=0.0)
        return

    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    recent: dict[str, float] = {}
    grace = max(interval * 3, 10.0)
    failures = 0

    print(f"watching tmux sessions every {interval}s")
    while True:
        try:
            sync_once(recent, grace=grace)
        except Exception as exc:
            failures += 1
            print(f"error ({failures}/{max_failures}): {exc}", file=sys.stderr)
            if failures >= max_failures:
                print(
                    f"giving up after {max_failures} consecutive failures",
                    file=sys.stderr,
                )
                sys.exit(1)
            # Back off as failures mount so a persistent fault (e.g. cmux not
            # running) doesn't spin at the poll rate. Capped so recovery is
            # still noticed promptly.
            time.sleep(min(interval * failures, 60.0))
            continue
        failures = 0
        time.sleep(interval)


if __name__ == "__main__":
    typer.run(main)
