#!/usr/bin/env bash
# Print the remote host when the current tmux pane is running ssh,
# otherwise the local short hostname. Used by the tmux status bar.

set -u
export LC_ALL=en_US.UTF-8

is_ssh() {
    local cmd
    cmd=$(tmux display-message -p '#{pane_current_command}' 2>/dev/null)
    [[ "$cmd" == "ssh" || "$cmd" == "sshpass" ]]
}

remote_host() {
    local pid line
    pid=$(tmux display-message -p '#{pane_pid}' 2>/dev/null) || return
    # Match ssh as a whole word so sshfs / a path containing "ssh" don't hit.
    line=$(
        { pgrep -flaP "$pid" 2>/dev/null; ps -o command= -p "$pid" 2>/dev/null; } \
            | grep -m1 -E '(^|[/[:space:]])ssh[[:space:]]'
    )
    [[ -n "$line" ]] || return
    # The destination is the first token after "ssh" that is neither an option
    # nor an option's value. Options taking a separate value (e.g. -p 22, -o
    # Foo=bar) consume the next token so it isn't mistaken for the host.
    awk '
        BEGIN { takes_arg = "bcDEeFIiJLlmOopQRSWw" }
        {
            for (start = 1; start <= NF && $start !~ /(^|\/)ssh$/; start++);
            for (i = start + 1; i <= NF; i++) {
                if (substr($i, 1, 1) == "-") {
                    if (length($i) == 2 && index(takes_arg, substr($i, 2, 1))) i++
                    continue
                }
                print $i; exit
            }
        }
    ' <<<"$line" | cut -d@ -f2-
}

if is_ssh; then
    host=$(remote_host)
    [[ -n "$host" ]] && { echo "$host"; exit 0; }
fi

hostname -s
