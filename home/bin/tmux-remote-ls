#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "typer",
# ]
# ///
"""List tmux sessions across the Macs in one view.

Roughly `ssh <host> tmux ls` for each machine, but parsed: sessions are sorted,
annotated with attached/detached and window count, and grouped under their
host.

`tmux-ls` in ~/.bashrc.d/20-tmux.bash shows one host at a time, and only the host that
direnv happens to have exported. This asks every machine at once, so a session
left running on the Studio is visible from the Air without guessing where it
went.

Whichever machine you are sitting at is skipped -- no point sshing to
localhost, and it may not even accept ssh. Pass --include-local to include it
anyway; it is then queried by running tmux directly, never over the network.

Hosts come from ~/.config/cmux-tmux/hosts.toml (edit it when a machine joins or
leaves), or from --host / $TMUX_REMOTE_HOSTS.

Remote hosts are queried through cmux's `remote.tmux.sessions` rpc first --
one Unix-socket round trip to the local cmux app, no ssh process of our own --
falling back to ssh when that fails (cmux not running, host unreachable, or
the remote-tmux beta flag off for this account). The ssh fallback is a
one-shot non-interactive command, matching what tmux-ls and tmux-kill already
do. BatchMode means an unreachable or auth-prompting host fails fast instead
of hanging the whole run.

Sessions from the rpc path carry no cwd (cmux does not report one), so their
path column prints as "(unknown)"; sessions from the ssh fallback show the
real path.

--json adds "source" ("local", "rpc", or "ssh") and "rpc_fallback_reason" per
host, so a scripted caller can tell which path actually answered without
guessing from the path column. Text/--sessions-only output stays unchanged.
"""

import json
import subprocess
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from typing import Annotated, Optional

import typer

from _cmux import (
    default_hosts,
    TmuxSession,
    is_local_host,
    remote_tmux_sessions,
    remote_tmux_sessions_via_rpc,
    tmux_sessions,
)


@dataclass
class HostResult:
    host: str
    sessions: list[TmuxSession]
    error: str | None = None
    # "local", "rpc", or "ssh" -- which path actually produced `sessions`.
    source: str = "ssh"
    # Why the rpc path was skipped in favor of ssh, or None when rpc worked
    # (or wasn't attempted, e.g. the local/--include-local path).
    rpc_fallback_reason: str | None = None


def query(host: str, *, timeout: int) -> HostResult:
    # Set before the ssh call (which may itself raise), so a failure there
    # still reports why rpc was skipped in the first place, not just that
    # ssh also failed.
    source, rpc_fallback_reason = "local", None
    try:
        # tmux_sessions() runs tmux here rather than over ssh, so
        # --include-local works on a machine with no ssh server.
        if is_local_host(host):
            sessions = tmux_sessions()
        else:
            sessions, rpc_fallback_reason = remote_tmux_sessions_via_rpc(host, timeout=timeout)
            if sessions is None:
                source = "ssh"
                sessions = remote_tmux_sessions(host, timeout=timeout)
            else:
                source = "rpc"
    except subprocess.TimeoutExpired:
        return HostResult(
            host, [], error=f"timed out after {timeout * 4}s",
            source=source, rpc_fallback_reason=rpc_fallback_reason,
        )
    except (RuntimeError, OSError) as exc:
        return HostResult(
            host, [], error=str(exc),
            source=source, rpc_fallback_reason=rpc_fallback_reason,
        )
    return HostResult(
        host,
        sorted(sessions, key=lambda session: session.name),
        source=source,
        rpc_fallback_reason=rpc_fallback_reason,
    )


def report(results: list[HostResult], *, sessions_only: bool) -> int:
    failures = 0
    for result in results:
        if result.error:
            failures += 1
            if not sessions_only:
                print(f"{result.host}: error: {result.error}")
            continue

        if sessions_only:
            for session in result.sessions:
                print(f"{result.host}:{session.name}")
            continue

        if not result.sessions:
            print(f"{result.host}: no sessions")
            continue

        print(f"{result.host}:")
        for session in result.sessions:
            state = "attached" if session.is_attached else "detached"
            windows = f"{session.windows} window{'' if session.windows == 1 else 's'}"
            path = session.path or "(unknown)"
            print(f"  {session.name}  [{state}, {windows}]  {path}")

    return failures


def main(
    hosts: Annotated[
        Optional[list[str]],
        typer.Option("--host", "-H", help="Host to query (repeatable); overrides the defaults"),
    ] = None,
    timeout: Annotated[
        int, typer.Option("--timeout", "-t", help="ssh connect timeout in seconds")
    ] = 5,
    include_local: Annotated[
        bool,
        typer.Option("--include-local", help="Also list this machine (run locally, no ssh)"),
    ] = False,
    sessions_only: Annotated[
        bool,
        typer.Option("--sessions-only", "-s", help="Print bare host:session lines, no headers"),
    ] = False,
    as_json: Annotated[bool, typer.Option("--json", help="Emit JSON instead of text")] = False,
) -> None:
    targets = hosts or default_hosts()

    if not include_local:
        targets = [host for host in targets if not is_local_host(host)]
    if not targets:
        print("No hosts to query (only this machine; pass --include-local to see it)")
        return

    # Hosts are queried concurrently so one unreachable machine costs its own
    # timeout rather than delaying every host behind it.
    with ThreadPoolExecutor(max_workers=len(targets)) as pool:
        results = list(pool.map(lambda host: query(host, timeout=timeout), targets))

    if as_json:
        print(
            json.dumps(
                [
                    {
                        "host": result.host,
                        "error": result.error,
                        "source": result.source,
                        "rpc_fallback_reason": result.rpc_fallback_reason,
                        "sessions": [
                            {
                                "name": session.name,
                                "attached": session.is_attached,
                                "windows": session.windows,
                                "path": session.path,
                            }
                            for session in result.sessions
                        ],
                    }
                    for result in results
                ],
                indent=2,
            )
        )
        failures = sum(1 for result in results if result.error)
    else:
        failures = report(results, sessions_only=sessions_only)

    # Non-zero when a host could not be reached, so scripted callers can tell
    # "no sessions anywhere" apart from "we never got an answer".
    if failures:
        raise typer.Exit(code=1)


if __name__ == "__main__":
    typer.run(main)
