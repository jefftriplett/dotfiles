#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "tomli-w",
#     "typer",
# ]
# ///
"""Dump cmux workspace session (titles, cwds, colors, pins, descriptions).

cmux can't tell us whether a workspace is running mosh or tmux, so the
optional `host` and `tmux` fields are hand-edited in the dump file and
preserved (matched by title) when re-dumping over an existing file.
Annotated entries whose workspaces are closed are kept too, so closing a
workspace doesn't lose its config. cmux-dump-restore uses these fields to mosh
to a remote host and/or attach a tmux session.
"""

import json
import subprocess
import tomllib
from pathlib import Path
from typing import Annotated, Optional

import typer

from _cmux import DEFAULT_TOML, Workspace, load_dump, save_dump

DEFAULT_OUTPUT = DEFAULT_TOML


def load_previous(path: Path) -> dict[str, Workspace]:
    """Map titles to prior dump entries so hand-edited fields survive."""
    if not path.is_file():
        return {}
    try:
        entries = load_dump(path)
        return {ws["title"]: Workspace.from_dump(ws) for ws in entries}
    except (json.JSONDecodeError, tomllib.TOMLDecodeError, KeyError, TypeError, OSError) as exc:
        print(f"Refusing to overwrite unreadable {path}: {exc}")
        print("Fix or remove the file, then re-run.")
        raise typer.Exit(code=1)


def main(
    output: Annotated[
        Optional[Path],
        typer.Argument(help="Output file (default: ~/.config/cmux-tmux/session-dump.toml)"),
    ] = None,
) -> None:
    # TOML is the only output format. Legacy JSON dumps are still read (see
    # load_dump / default_dump_path), but new writes are always TOML.
    if output is None:
        output = DEFAULT_OUTPUT
    output.parent.mkdir(parents=True, exist_ok=True)

    result = subprocess.run(
        ["cmux", "workspace", "list", "--json"],
        capture_output=True,
        text=True,
        check=True,
    )
    previous = load_previous(output)
    workspaces = []
    for entry in json.loads(result.stdout)["workspaces"]:
        ws = Workspace.from_cmux(entry)
        prior = previous.pop(ws.title, None)
        if prior is not None:
            ws.host = prior.host
            ws.tmux = prior.tmux
            ws.session = prior.session
        workspaces.append(ws)

    # Keep annotated entries whose workspaces are no longer open
    kept = [ws for ws in previous.values() if ws.annotated]
    workspaces.extend(kept)

    save_dump(output, workspaces)

    note = f" (kept {len(kept)} closed annotated)" if kept else ""
    print(f"Saved {len(workspaces)} workspaces to {output}{note}")


if __name__ == "__main__":
    typer.run(main)
