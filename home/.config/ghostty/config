# background-opacity=0.95
clipboard-paste-protection = false
confirm-close-surface = false
copy-on-select = clipboard
# cursor-style = block
cursor-style-blink = false
font-family = Hack Nerd Font Mono
font-feature=-liga
font-size = 20
# font-thicken = true
# Always consume cmd+c as copy so it never leaks a bare "c" into the pane when
# there's no selection (Ghostty's default binding is performable and passes the
# key through in that case, which bites inside herdr where herdr owns the mouse).
# copy-on-select already handles the actual copying, so this is mostly a guard.
keybind = cmd+c=copy_to_clipboard
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1
keybind = shift+enter=text:\x1b\r
mouse-scroll-multiplier = 5
shell-integration-features = no-cursor
theme = dracula
unfocused-split-opacity = 1.0
window-inherit-working-directory = false
working-directory = home
