set dotenv-load := false
set export
set quiet
set unstable

export HOMEBREW_NO_ENV_HINTS := "true"
export JUST_UNSTABLE := "true"
export PIP_REQUIRE_VIRTUALENV := "false"

# export HOMEBREW_NO_AUTO_UPDATE := "true"

mod llm '.justfiles/llm.justfile'
mod homebrew '.justfiles/homebrew.justfile'
mod macos '.justfiles/macos.justfile'
mod mise '.justfiles/mise.justfile'
mod python '.justfiles/python.justfile'

HOST := `hostname -s`
RICH_THEME := "dracula"
DOTFILES_DIR := env_var_or_default("HOMESICK_REPO", "$HOME/.homesick/repos/dotfiles")

alias lock := freeze

# ----------------------------------------------------------------
# In the spirit of "Scripts to rule them all"
# ----------------------------------------------------------------

[private]
@default:
    just --list --list-submodules

# install and update all dependencies
[group("setup")]
@bootstrap:
    echo "==> Installing homesick..."
    gem install homesick

    echo "==> Creating symlinks..."
    homesick symlink

    if [ "$(uname -s)" = "Darwin" ]; then \
        if [ -f "Brewfile.{{ HOST }}" ]; then \
            echo "==> Installing Homebrew dependencies from Brewfile.{{ HOST }}..."; \
            brew bundle install --file="Brewfile.{{ HOST }}"; \
        elif [ -f "Brewfile" ]; then \
            echo "==> No Brewfile.{{ HOST }} yet; installing from the generic Brewfile..."; \
            brew bundle install; \
        fi; \
    fi

    just macos::xcode-bootstrap
    just mise::bootstrap
    just python::bootstrap

# clean up old Homebrew packages and casks
[arg("DAYS", long="days", pattern='\d+|all', help="prune cache older than DAYS, or 'all'")]
[group("maintenance")]
@cleanup DAYS="0":
    just homebrew::cleanup --days={{ DAYS }}

# format and overwrite justfile
[group("utils")]
@fmt:
    just --fmt --unstable
    just llm fmt
    just homebrew fmt
    just macos fmt
    just mise fmt
    just python fmt

# update lockfiles without installing dependencies
[group("utils")]
@freeze:
    just homebrew::freeze

# create symlinks for dotfiles using homesick
[group("setup")]
@install:
    # Claude Code writes ~/.claude.json through its symlink and leaves temp
    # files next to the target in home/; homesick would link every one of them.
    rm -f "{{ DOTFILES_DIR }}"/home/.claude.json.tmp.*
    homesick symlink

# run every lint hook in .pre-commit-config.yaml against the whole tree
[group("utils")]
@lint:
    cd "{{ DOTFILES_DIR }}" && uv run --with prek prek run --all-files

# run validation checks
[group("utils")]
@test:
    just lint

# list outdated packages from Homebrew and pip
[group("maintenance")]
@outdated:
    just homebrew::outdated

# update project to run at its current version
[group("maintenance")]
@update:
    just upgrade
    just restart
    just cleanup

# update and upgrade Homebrew packages
[group("maintenance")]
@upgrade:
    echo "==> Updating dotfiles..."
    -git -C "{{ DOTFILES_DIR }}" pull

    echo "==> Creating symlinks..."
    just install

    just homebrew::upgrade
    just homebrew::cleanup
    just mise::upgrade
    just python::upgrade
    just llm::upgrade

    echo "==> Updating tmux plugins..."
    -[ -x "$HOME/.tmux/plugins/tpm/bin/update_plugins" ] && "$HOME/.tmux/plugins/tpm/bin/update_plugins" all

    echo "==> Refreezing the Brewfile..."
    just freeze

# upgrade all tools (uv pythons and mise packages)
[group("maintenance")]
@upgrade-all:
    just python::uv-python-install
    just mise::upgrade

# ----------------------------------------------------------------
# Database operations
# ----------------------------------------------------------------

# upgrade PostgreSQL to latest version and migrate databases
[group("database")]
@postgresql-upgrade:
    brew unpin postgresql
    brew upgrade postgresql
    brew pin postgresql
    brew postgresql-upgrade-database

# ----------------------------------------------------------------
# Service management
# ----------------------------------------------------------------

# restart Homebrew services
[group("services")]
@restart:
    just homebrew::services-restart

# stop all Homebrew services
[group("services")]
@stop:
    just homebrew::services-stop

# ----------------------------------------------------------------
# Quick access shortcuts
# ----------------------------------------------------------------

# open documentation in browser using Tailscale/golinks
[group("shortcuts")]
@open-docs:
    open http://go/docs

# open Tailscale/golinks homepage
[group("shortcuts")]
@open-go:
    open http://go

# open Home Assistant interface in browser
[group("shortcuts")]
@open-ha:
    open http://go/homeassistant

# open Syncthing interface in browser
[group("shortcuts")]
@open-syncthing:
    open http://go/syncthing

# ----------------------------------------------------------------
# Utilities
# ----------------------------------------------------------------

# update Brewfile from cog template
[group("utils")]
@update-brewfile:
    cd "{{ DOTFILES_DIR }}/home" && uv run --with cogapp cog -Pr ./Brewfile.cog

# regenerate the recipe list in docs/just.md using cog
[group("docs")]
@update-docs:
    cd "{{ DOTFILES_DIR }}" && uv run --with cogapp cog -I . -Pr ./docs/just.md

alias update-readme-docs := update-docs

# build the manual into site/ with zensical
[group("docs")]
@docs-build:
    cd "{{ DOTFILES_DIR }}" && uvx zensical build

# serve the manual locally with live reload
[group("docs")]
@docs-serve:
    cd "{{ DOTFILES_DIR }}" && uvx zensical serve
