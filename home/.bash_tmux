# shellcheck shell=bash

# shellcheck source=.tmux_session_name.bash
[[ -r "${HOME}/.tmux_session_name.bash" ]] &&
    source "${HOME}/.tmux_session_name.bash"

__tmux_session_name() {
    local name="${1:-${TMUX_AUTOATTACH:-$(basename "$PWD")}}"

    # Falls back to the identity if the shared file is missing, so a
    # half-symlinked checkout degrades to "session name is the directory
    # name" rather than to an unbound-command error at every prompt.
    if declare -F tmux_session_slug >/dev/null; then
        tmux_session_slug "$name"
    else
        printf '%s' "$name"
    fi
}

__tmux_set_title() {
    printf '\033]0;%s\007' "$1"
}

__tmux_target_host() {
    printf '%s' "${TMUX_AUTOATTACH_HOST:-${TMUX_AUTOATTACH_MACHINE:-}}"
}

__tmux_target_path() {
    printf '%s' "${TMUX_AUTOATTACH_PATH:-}"
}

__tmux_remote_tmux_string() {
    local quoted
    local remote_command="tmux"

    for arg in "$@"; do
        printf -v quoted '%q' "$arg"
        remote_command="${remote_command} ${quoted}"
    done

    printf '%s' "$remote_command"
}

__tmux_remote_tmux_command() {
    printf 'bash -lc %q' "$(__tmux_remote_tmux_string "$@")"
}

__tmux_remote_path_expr() {
    local path="$1"
    local quoted remote_home
    # This is emitted for the remote login shell, not expanded locally.
    # shellcheck disable=SC2016
    remote_home='"$HOME"'

    if [[ "$path" == "~" ]]; then
        printf '%s' "$remote_home"
    elif [[ "${path:0:1}" == "~" && "${path:1:1}" == "/" ]]; then
        printf -v quoted '%q' "${path:2}"
        printf '%s/%s' "$remote_home" "$quoted"
    else
        printf -v quoted '%q' "$path"
        printf '%s' "$quoted"
    fi
}

# Sets __tmux_argv to the local command that attaches the remote session.
# Interactive attaches use mosh when available (matching cmux-dump-restore),
# falling back to ssh. mosh passes the command to mosh-server as a clean
# argv, so it is quoted once; ssh re-parses on the remote, so it gets the
# extra %q layer.
__tmux_remote_attach_argv() {
    local host="$1"
    local path="$2"
    shift 2
    local path_expr tmux_string
    tmux_string="$(__tmux_remote_tmux_string "$@")"
    if [[ -n "$path" ]]; then
        path_expr="$(__tmux_remote_path_expr "$path")"
        tmux_string="cd ${path_expr} && ${tmux_string}"
    fi

    if command -v mosh >/dev/null 2>&1; then
        __tmux_argv=(direnv exec / env mosh "$host" -- bash -lc "$tmux_string")
    else
        __tmux_argv=(direnv exec / env ssh -t "$host" "bash -lc $(printf '%q' "$tmux_string")")
    fi
}

# Sets __tmux_argv to the full local command that opens session `$2` on host
# `$1` ("" for here). The one place the bash side decides what "attach" means,
# so tmux-go, tmux-new, and the direnv autoattach cannot drift apart -- the
# last two used to build this inline and separately.
#
# -c is passed only when a path is known: `new-session -c ""` is an error, and
# omitting it lets tmux use the current directory, which is what you want when
# nothing has said otherwise.
__tmux_attach_argv() {
    local host="$1"
    local name="$2"
    local path
    path="$(__tmux_target_path)"

    local session_args=(new-session -A -s "$name")
    if [[ -n "$path" ]]; then
        session_args+=(-c "$path")
    fi

    if [[ -n "$host" ]]; then
        __tmux_remote_attach_argv "$host" "$path" "${session_args[@]}"
    else
        if [[ -n "$path" && ! -d "$path" ]]; then
            printf 'tmux: project directory does not exist: %s\n' "$path" >&2
            return 1
        fi
        __tmux_argv=(direnv exec / env tmux "${session_args[@]}")
    fi
}

__tmux_attach() {
    __tmux_attach_argv "$1" "$2" || return
    "${__tmux_argv[@]}"
}

tmux() {
    direnv exec / tmux "$@"
}

tmux-new() {
    local host
    local name
    name="$(__tmux_session_name "$1")"
    host="$(__tmux_target_host)"

    if [[ -n "$host" ]]; then
        __tmux_set_title "${host}:${name}"
    else
        __tmux_set_title "$name"
    fi

    __tmux_attach "$host" "$name"
}

tmux-go() {
    local host
    local name
    local path
    name="$(__tmux_session_name "$1")"
    host="$(__tmux_target_host)"
    path="$(__tmux_target_path)"

    if [[ -n "$host" ]]; then
        __tmux_set_title "${host}:${name}"
        __tmux_attach "$host" "$name"
        return $?
    fi

    __tmux_set_title "$name"

    if [[ -n "$path" && ! -d "$path" ]]; then
        printf 'tmux-go: project directory does not exist: %s\n' "$path" >&2
        return 1
    fi

    if [[ -n "$TMUX" ]]; then
        local new_args=(new-session -d -s "$name")
        if [[ -n "$path" ]]; then
            new_args+=(-c "$path")
        fi
        tmux has-session -t "$name" 2>/dev/null || tmux "${new_args[@]}"
        tmux switch-client -t "$name"
    else
        __tmux_attach "" "$name"
    fi
}

tmux-resume() {
    tmux-go "$@"
}

tmux-attach() {
    tmux-go "$@"
}

tmux-ls() {
    local host
    local json=0
    local args=()

    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            json=1
        else
            args+=("$arg")
        fi
    done

    host="$(__tmux_target_host)"

    if (( json )); then
        # Remaining args would be tmux list-sessions flags (-F and friends),
        # which conflict with the fixed format the JSON output is built from.
        if (( ${#args[@]} )); then
            printf 'tmux-ls: --json cannot be combined with %s\n' "${args[*]}" >&2
            return 2
        fi
        # Hand off to tmux-remote-ls so it owns the JSON schema and the string
        # escaping; a session name or path with a quote in it stays valid JSON.
        # It is given one explicit host so the output covers the same machine
        # this function would have listed, not the whole fleet.
        if [[ -n "$host" ]]; then
            tmux-remote-ls --json --host "$host"
        else
            tmux-remote-ls --json --include-local --host "$(hostname -s)"
        fi
        return $?
    fi

    if [[ -n "$host" ]]; then
        direnv exec / env ssh "$host" "$(__tmux_remote_tmux_command list-sessions "${args[@]}")"
    else
        tmux list-sessions "${args[@]}"
    fi
}

tmux-kill() {
    local host
    local name
    name="$(__tmux_session_name "$1")"
    host="$(__tmux_target_host)"

    if [[ -n "$host" ]]; then
        direnv exec / env ssh "$host" "$(__tmux_remote_tmux_command kill-session -t "$name")"
    else
        tmux kill-session -t "$name"
    fi
}

__tmux_autoattach() {
    local host
    local name

    [[ $- == *i* ]] || return 0
    [[ -z "$TMUX" ]] || return 0
    [[ -t 1 ]] || return 0
    [[ -z "$NO_TMUX_AUTOATTACH" ]] || return 0
    command -v direnv >/dev/null 2>&1 || return 0

    eval "$(direnv export bash 2>/dev/null)"
    [[ -n "$TMUX_AUTOATTACH" ]] || return 0

    name="$(__tmux_session_name "$TMUX_AUTOATTACH")"
    host="$(__tmux_target_host)"

    if [[ -n "$host" ]]; then
        __tmux_set_title "${host}:${name}"
    else
        __tmux_set_title "$name"
    fi

    # exec, unlike tmux-go: this replaces the shell that was starting up, so
    # detaching the session leaves you with no leftover bash underneath it.
    __tmux_attach_argv "$host" "$name" || return
    exec "${__tmux_argv[@]}"
}

__tmux_sessions() {
    [[ -z "$(__tmux_target_host)" ]] || return 0
    tmux list-sessions -F '#S' 2>/dev/null
}

_tmux_session_completions() {
    local cur sessions
    cur="${COMP_WORDS[COMP_CWORD]}"
    sessions="$(__tmux_sessions)"
    mapfile -t COMPREPLY < <(compgen -W "$sessions" -- "$cur")
}

complete -F _tmux_session_completions tmux-go tmux-resume tmux-attach tmux-kill

alias t='tmux'
alias ta='tmux-go'
alias tn='tmux-new'
alias tk='tmux-kill'
alias tls='tmux-ls'
